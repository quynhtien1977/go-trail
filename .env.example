# Go-Trail local configuration — PRD 15.6.
# Copy this file to .env and fill in credentials for the go-trail project only.
# Keep real .env files private. All variables below are server-only.

# PostgreSQL URL for Prisma runtime (not the Supabase project API URL).
# Use the connection mode recommended for the deployment and Prisma version.
DATABASE_URL=
# Optional direct/session URL for migrations when DATABASE_URL uses a
# transaction pooler. Prisma CLI and seed prefer DIRECT_URL when set.
DIRECT_URL=

# Auth.js session secret: use a cryptographically random value (32+ characters).
AUTH_SECRET=
# Canonical Auth.js URL; use the actual HTTPS application URL in production.
NEXTAUTH_URL=http://localhost:3000

# Webhook authentication secret configured in SePay (Authorization: Apikey ...).
# This is not a banking/refund API token.
SEPAY_API_KEY=

# Random Bearer token for /api/cron/*; do not reuse AUTH_SECRET.
CRON_SECRET=

# Company receiving account for VietQR; never put customer refund accounts here.
# Leave blank until the team's actual receiving account is configured.
BANK_ID=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Development seed accounts only; minimum 16 characters, maximum 72 UTF-8 bytes.
# Never use this password for production accounts.
SEED_PASSWORD=

# Server-only Upstash REST credentials; never use NEXT_PUBLIC_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional counter namespace; blank derives from VERCEL_ENV / NODE_ENV.
AUTH_RATE_LIMIT_NAMESPACE=

# LEADER_RATIO, SEAT_TTL_MINUTES and MAX_SEATS_PER_INVOICE belong in
# SYSTEM_SETTINGS, not env. Payment-code prefix is configured in SePay.

# Public Supabase Storage CDN URL for tour & media assets
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://anqtlegcsrqzqenytrjo.supabase.co/storage/v1/object/public/gotrail-media
