{
  "name": "go-trail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "audit:check": "node scripts/ci/check-audit.mjs",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-isolation=none tests/*.test.mjs",
    "test:auth:http": "node --conditions=react-server --import tsx tests/smoke/auth-http.mjs",
    "test:catalog:http": "node --conditions=react-server --import tsx tests/smoke/catalog-http.mjs",
    "test:rbac:http": "node --conditions=react-server --import tsx tests/smoke/rbac-http.mjs",
    "test:assignments:concurrency": "node --conditions=react-server --import tsx tests/integration/assignment-concurrency.mjs",
    "test:auth:redis": "node --conditions=react-server --import tsx tests/smoke/auth-redis.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:catalog": "tsx scripts/catalog/import-catalog.ts",
    "db:media": "tsx scripts/catalog/import-media.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@next/env": "16.4.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@upstash/redis": "1.39.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
